generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReadingSession {
  id          String   @id @default(uuid())
  userName    String
  persona     String
  theme       String
  cardsDrawn  Json     // Array com os objetos das 5 cartas sorteadas
  aiReading   Json     // Objeto completo retornado pelo Gemini
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("reading_sessions")
}
