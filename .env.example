# ==========================================
# 1. BANCO DE DADOS (SUPABASE POSTGRESQL)
# ==========================================
# Substitua [SUA-SENHA] pela senha do banco de dados criada no Supabase
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ==========================================
# 2. INTELIGÊNCIA ARTIFICIAL (GEMINI API)
# ==========================================
# Se deixar vazio ou ausente, o sistema ativa automaticamente o Fallback Inteligente baseado no Baralho Lenormand
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_MODEL_FALLBACK="gemini-2.5-flash-lite"

# ==========================================
# 3. REGRAS DE NEGÓCIO E CHECKOUT PROTÓTIPO
# ==========================================
NEXT_PUBLIC_PIX_KEY=

# ==========================================
# 4. UPSELL WHATSAPP (HORA MARCADA)
# ==========================================
# Formato internacional: DDI + DDD + Telefone (ex: 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Gere uma chave aleatória e estável para os acessos de consulta.
ORACLE_ACCESS_SECRET=
# Ative apenas na demonstração local; não é confirmação de pagamento.
ORACLE_DEMO_MODE=false
ORACLE_LIVE_ENABLED=false
ORACLE_TTS_MODEL=gemini-3.8-flash-tts

# Pagamento Pix (PagBank, API de pedidos). Preços em src/lib/pricing.ts.
# Pagamento ativo: checkout da InfinitePay (Pix e cartão na página dela). Sem sandbox; teste com compra real.
# INFINITEPAY_HANDLE = sua InfiniteTag sem $. INFINITEPAY_API_KEY (opcional, inchk_...) liga link de uso único.
INFINITEPAY_HANDLE=
INFINITEPAY_API_KEY=
# PagBank (código mantido, inativo até a conta ter a API liberada em produção)
PAGBANK_TOKEN=""
PAGBANK_ENV="sandbox"                 # "production" para cobrar de verdade
NEXT_PUBLIC_PAGBANK_ENV="sandbox"     # "production" esconde os botões de simulação (valor lido no build)
PUBLIC_BASE_URL=""                    # ex.: https://seu-dominio — URL pública para o webhook do PagBank
GEMINI_TIMEOUT_MS="100000"
PAGBANK_PROD_TOKEN=""                 # token de produção, só para /teste-pagamento (Pix real de até R$ 10)
PAGBANK_TEST_KEY=""                   # senha da página /teste-pagamento?chave=...
ORACLE_TTS_MODEL_FALLBACK=""          # modelos reserva da narração, usados em qualquer erro do principal
ORACLE_TTS_MODEL_FALLBACK2=""
ORACLE_TTS_MODEL_FALLBACK3=
# Intervalo minimo (ms) entre geracoes de voz; falha tenta de novo ate 3 vezes (30s, 60s).
ORACLE_TTS_GAP_MS=4000
