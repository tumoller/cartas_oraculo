generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReadingSession {
  id          String   @id @default(uuid())
  userName    String
  persona     String
  theme       String
  cardsDrawn  Json     // Array com os objetos das 5 cartas sorteadas
  aiReading   Json     // Objeto completo retornado pelo Gemini
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("reading_sessions")
}

// Pix via PagBank (API de pedidos). "unlock" abre o resto da leitura de 5; "prepaid" libera 9/36 antes do sorteio.
model Payment {
  id        String    @id @default(uuid())
  readingId String
  kind      String
  spread    String
  amount    Int
  orderId   String?   @unique
  status    String    @default("PENDING")
  pixText   String?
  pixImage  String?
  expiresAt DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readingId])
  @@map("payments")
}
